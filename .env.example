# Only needed for the live prompting arms (`make prompt-*`). Everything else runs without keys.
# Your Azure AI Foundry resource's OpenAI v1 endpoint, ending in /openai/v1/
AZURE_OPENAI_BASE_URL=
# Optional. Without a key the harness signs in with Entra ID (DefaultAzureCredential),
# for example through AZURE_CLIENT_ID, AZURE_TENANT_ID and AZURE_CLIENT_SECRET.
AZURE_OPENAI_API_KEY=
